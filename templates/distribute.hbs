<section class="rf-form">
  <div class="rf-drop{{#if h}} has-doc{{/if}}">
    {{#if h}}
      {{#if h.preview}}<img class="rf-prev-img" src="{{h.preview}}" alt="">{{else}}<span class="rf-prev-icon"><i class="fa-solid {{#if (eq h.type "entry")}}fa-book{{else}}fa-file-lines{{/if}}"></i></span>{{/if}}
      <div class="rf-prev-info">
        <span class="rf-prev-kind">{{#if (eq h.kind "image")}}Image{{else if (eq h.kind "entry")}}Journal entier · {{h.count}} page(s){{else}}Page de journal{{#if h.parentName}} · {{h.parentName}}{{/if}}{{/if}}</span>
        <span class="rf-prev-hint">Glissez un autre document ici pour le remplacer</span>
      </div>
      <button type="button" class="rf-icon" data-action="clearDoc" data-tooltip="Retirer"><i class="fa-solid fa-xmark"></i></button>
    {{else}}
      <i class="fa-solid fa-hand-pointer rf-drop-ico"></i>
      <span>Glisser ici une <b>page</b> ou un <b>journal</b>, une <b>tuile</b> ou un <b>acteur</b> (son image)</span>
      <button type="button" data-action="pickImage"><i class="fa-solid fa-image"></i> Choisir une image…</button>
    {{/if}}
  </div>

  <div class="form-group">
    <label>Titre</label>
    <div class="form-fields"><input type="text" name="title" value="{{h.title}}" placeholder="ex. Carte du donjon de Vieille-Tour"></div>
  </div>
  <div class="form-group">
    <label>Mot du MJ</label>
    <div class="form-fields"><input type="text" name="note" value="" placeholder="Facultatif — ex. trouvée sur le cadavre du capitaine gobelin"></div>
  </div>

  <div class="form-group">
    <label>Expéditeur</label>
    <div class="form-fields"><input type="text" name="sender" value="" placeholder="Facultatif — ex. Elminster, ou la Guilde des voleurs"></div>
    <p class="hint">Affiché en tête du parchemin : « De la part de… ».</p>
  </div>

  <fieldset class="rf-players">
    <legend>Destinataires
      <span class="rf-legend-tools">
        <button type="button" data-action="all">Tous</button>
        <button type="button" data-action="none">Aucun</button>
      </span>
    </legend>
    {{#each players as |p|}}
      <label class="rf-player{{#unless p.active}} offline{{/unless}}">
        <input type="checkbox" name="users" value="{{p.id}}" {{#if p.active}}checked{{/if}}>
        <span class="rf-dot" style="background:{{p.color}}"></span>
        <span class="rf-pname">{{p.name}}{{#if p.character}} <em>— {{p.character}}</em>{{/if}}</span>
        {{#if p.book}}
          <i class="fa-solid fa-book-bookmark rf-ok" data-tooltip="Journal de bord trouvé"></i>
        {{else if ../canCreate}}
          <i class="fa-solid fa-book-medical rf-new" data-tooltip="Pas de journal : il sera créé"></i>
        {{else}}
          <i class="fa-solid fa-triangle-exclamation rf-warn" data-tooltip="Pas de journal d'aventure"></i>
        {{/if}}
      </label>
    {{else}}
      <p class="rf-empty">Aucun joueur dans ce monde.</p>
    {{/each}}
    <p class="rf-hint">Les joueurs connectés sont cochés.
      {{#if folder}}Journaux de bord : <b>{{folder}}</b>.{{else}}<span class="rf-warn">Aucun dossier « Journal de bord » trouvé (réglages du module).</span>{{/if}}</p>
  </fieldset>

  <fieldset class="rf-opts">
    <label><input type="checkbox" name="reveal" checked> Faire apparaître le document à l'écran</label>
    <label><input type="checkbox" name="file" checked> Ranger une copie dans leur journal d'aventure</label>
    <label class="rf-sub"><input type="checkbox" name="choice"> Laisser le joueur choisir de la ranger ou non</label>
    {{#if h}}{{#unless (eq h.kind "image")}}
      <label><input type="checkbox" name="grant"> Leur donner aussi l'accès en lecture au journal d'origine</label>
    {{/unless}}{{/if}}
    <label><input type="checkbox" name="preview" checked> Voir l'animation moi aussi</label>
  </fieldset>

  <footer class="rf-foot">
    <button type="submit" class="rf-go" {{#unless h}}disabled{{/unless}}><i class="fa-solid fa-paper-plane"></i> Remettre</button>
  </footer>
</section>
